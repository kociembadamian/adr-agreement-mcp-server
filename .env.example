# Konfiguracja Asystenta ADR (MCP)
# Ten plik jest gotowy do uzycia od razu — plug and play.
# Jesli chcesz wlasny, wyzszy limit: skopiuj ten plik jako ".env"
# i podmien ADR_API_TOKEN na wlasny token (".env" NIE trafia do repo, patrz .gitignore).

# Adres API danych ADR — nie zmieniaj, chyba ze wiesz co robisz
ADR_API_URL=https://api.kocie.mba

# Domyslnie: publiczny klucz demo (limit 35 zapytan/dzien, wspolny dla wszystkich).
# Wlasny, wyzszy limit: napisz na damian@kocie.mba
ADR_API_TOKEN=DEMO-ADR-2026-PUBLIC

# Jezyk danych referencyjnych (pl / en) — wybiera folder data/pl lub data/en
ADR_DATA_LANG=pl
